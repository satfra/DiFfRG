+  template <typename VectorType>
+  typename IDA<VectorType>::Statistics
+  IDA<VectorType>::get_statistics() const
+  {
+    Statistics statistics;
+    if (ida_mem == nullptr)
+      return statistics;
+
+    statistics.valid = true;
+    int status = IDAGetNumSteps(ida_mem, &statistics.num_steps);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumResEvals(ida_mem, &statistics.num_residual_evaluations);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumLinSolvSetups(ida_mem, &statistics.num_linear_solver_setups);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumErrTestFails(ida_mem, &statistics.num_error_test_failures);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumNonlinSolvIters(ida_mem, &statistics.num_nonlinear_iterations);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetNumNonlinSolvConvFails(
+      ida_mem, &statistics.num_nonlinear_convergence_failures);
+    statistics.valid = statistics.valid && status >= 0;
+    status =
+      IDAGetNumStepSolveFails(ida_mem, &statistics.num_step_solve_failures);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetLastStep(ida_mem, &statistics.last_step_size);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetCurrentStep(ida_mem, &statistics.current_step_size);
+    statistics.valid = statistics.valid && status >= 0;
+    status = IDAGetCurrentTime(ida_mem, &statistics.current_time);
+    statistics.valid = statistics.valid && status >= 0;
+
+    return statistics;
+  }
+
+  template <typename VectorType>
+  bool
+  IDA<VectorType>::get_error_test_vectors(VectorType &estimated_local_errors,
+                                          VectorType &error_weights) const
+  {
+    if (ida_mem == nullptr)
+      return false;
+
+#  if DEAL_II_SUNDIALS_VERSION_GTE(6, 0, 0)
+    auto estimated_local_errors_view =
+      internal::make_nvector_view(estimated_local_errors, ida_ctx);
+    auto error_weights_view = internal::make_nvector_view(error_weights, ida_ctx);
+#  else
+    auto estimated_local_errors_view =
+      internal::make_nvector_view(estimated_local_errors);
+    auto error_weights_view = internal::make_nvector_view(error_weights);
+#  endif
+
+    int status = IDAGetEstLocalErrors(ida_mem, estimated_local_errors_view);
+    if (status < 0)
+      return false;
+    status = IDAGetErrWeights(ida_mem, error_weights_view);
+    return status >= 0;
+  }
